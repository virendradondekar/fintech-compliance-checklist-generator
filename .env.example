# Which AI backend to use: rules|anthropic|openai|ollama (default rules)
AI_PROVIDER=
# HTTP port for the server (default 3000)
PORT=
# Set to 1 to force mock mode (no external calls); default behavior with no keys
MOCK_MODE=
# Path to the JSON data file used for storing checklist runs (default ./db.json)
DB_FILE=
# API key for Anthropic Claude, only used if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# API key for OpenAI, only used if AI_PROVIDER=openai
OPENAI_API_KEY=
# Base URL for a local Ollama server, only used if AI_PROVIDER=ollama
OLLAMA_HOST=
# Model name to request from Ollama, only used if AI_PROVIDER=ollama
OLLAMA_MODEL=
